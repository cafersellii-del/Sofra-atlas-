          "type": "string",
          "minLength": 2,
          "maxLength": 32,
          "pattern": "^[a-z0-9\\-]+$"
        },
        "cityName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "district": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 90
        },
        "category": {
          "type": "string",
          "enum": [
            "Anadolu & Akdeniz",
            "Uzak Doğu",
            "Avrupa Klasikleri",
            "Sokak Lezzetleri",
            "Tatlı & Pastane"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 240
