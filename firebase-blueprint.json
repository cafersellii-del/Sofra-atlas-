  "firestore": {
    "/restaurants/{restaurantId}": {
      "schema": { "$ref": "#/entities/Restaurant" },
      "description": "Public profile documents for registered partner restaurants."
    },
    "/restaurants/{restaurantId}/private/contact": {
      "schema": { "$ref": "#/entities/RestaurantPrivateContact" },
      "description": "Owner-only private contact and tax information for registered restaurants."
    },
    "/couriers/{courierId}": {
      "schema": { "$ref": "#/entities/CourierProfile" },
      "description": "Profile and availability documents for registered courier partners."
    },
    "/couriers/{courierId}/private/contact": {
      "schema": { "$ref": "#/entities/CourierPrivateContact" },
      "description": "Owner-only private phone, email, and license/tax info for registered couriers."
    },
    "/dispatchJobs/{jobId}": {
      "schema": { "$ref": "#/entities/DispatchJob" },
      "description": "Non-PII courier dispatch queue items claimed atomically by verified couriers."
    },
    "/dishes/{dishId}": {
      "schema": { "$ref": "#/entities/PartnerDish" },
      "description": "Dishes published by registered partner restaurants."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Authorized platform administrators managed by bootstrapped admin."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/CustomerOrder" },
      "description": "Customer orders and online payment transaction records."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/MemberProfile" },
      "description": "Customer member profile and saved delivery defaults."
    },
    "/users/{userId}/savedCards/{cardId}": {
      "schema": { "$ref": "#/entities/SavedCard" },
      "description": "Owner-only tokenized card summaries (last4, brand, expiry) for faster checkout."
    }
  }
}
