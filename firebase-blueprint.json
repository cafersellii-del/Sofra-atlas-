{
  "entities": {
    "Restaurant": {
      "title": "Restaurant",
      "description": "Public storefront profile for a registered partner restaurant.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "cityId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32,
          "pattern": "^[a-z0-9\\-]+$"
        },
        "cityName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "district": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "cuisineCategory": {
          "type": "string",
          "enum": [
            "Anadolu & Akdeniz",
            "Uzak Doğu",
            "Avrupa Klasikleri",
            "Sokak Lezzetleri",
            "Tatlı & Pastane"
          ]
        },
        "avgPrepMinutes": {
          "type": "string",
          "minLength": 2,
          "maxLength": 30
        },
        "tagline": {
          "type": "string",
          "minLength": 4,
          "maxLength": 200
        },
        "status": {
          "type": "string",
          "enum": ["active", "paused"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "name",
        "cityId",
        "cityName",
        "district",
        "cuisineCategory",
        "avgPrepMinutes",
        "tagline",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "RestaurantPrivateContact": {
      "title": "RestaurantPrivateContact",
      "description": "Isolated PII and contact details for a registered restaurant owner.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
