        "isSpicy": {
          "type": "boolean"
        },
        "isChefSignature": {
          "type": "boolean"
        },
        "imagePreset": {
          "type": "string",
          "maxLength": 64
        },
        "isPublished": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "restaurantId",
        "restaurantName",
        "cityId",
        "cityName",
        "district",
        "name",
        "category",
        "description",
        "story",
        "ingredients",
        "priceTry",
        "prepMinutes",
        "calories",
        "isVegetarian",
        "isSpicy",
        "isChefSignature",
        "imagePreset",
        "isPublished",
        "createdAt",
        "updatedAt"
      ]
    },
