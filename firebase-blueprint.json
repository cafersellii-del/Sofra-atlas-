    "CustomerOrder": {
      "title": "CustomerOrder",
      "description": "Persisted customer food order with verified online payment metadata.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "orderNumber": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32
        },
        "cityId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32,
          "pattern": "^[a-z0-9\\-]+$"
        },
        "cityName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "neighborhood": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "address": {
          "type": "string",
          "minLength": 5,
          "maxLength": 200
        },
        "customerName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "customerPhone": {
          "type": "string",
          "minLength": 6,
          "maxLength": 30
        },
        "restaurantName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["card", "digital_wallet", "cash_on_delivery"]
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["paid", "pending_cod", "refunded"]
        },
        "gatewayLabel": {
          "type": "string",
          "minLength": 0,
          "maxLength": 60
        },
        "transactionId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        },
        "authCode": {
          "type": "string",
          "minLength": 0,
          "maxLength": 24
        },
        "cardBrand": {
          "type": "string",
          "minLength": 0,
          "maxLength": 24
        },
        "cardLast4": {
          "type": "string",
          "minLength": 0,
          "maxLength": 4
        },
        "refundId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        },
        "deliveryPreferences": {
          "type": "array"
        },
        "itemsSummary": {
          "type": "array"
        },
        "subtotalTry": {
          "type": "number"
        },
        "discountTry": {
          "type": "number"
        },
        "deliveryFeeTry": {
          "type": "number"
        },
        "totalTry": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["received", "preparing", "on_the_way", "delivered"]
        },
        "estimatedArrival": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "courierName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "courierId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128
        },
        "courierStatus": {
          "type": "string",
          "enum": ["waiting_courier", "accepted", "picked_up", "delivered"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "orderNumber",
        "cityId",
        "cityName",
        "neighborhood",
        "address",
        "customerName",
        "customerPhone",
        "restaurantName",
        "paymentMethod",
        "paymentStatus",
        "gatewayLabel",
        "transactionId",
        "authCode",
        "cardBrand",
        "cardLast4",
        "refundId",
        "deliveryPreferences",
        "itemsSummary",
        "subtotalTry",
        "discountTry",
        "deliveryFeeTry",
        "totalTry",
        "status",
        "estimatedArrival",
        "courierName",
        "createdAt",
        "updatedAt"
      ]
    },
    "SavedCard": {
      "title": "SavedCard",
      "description": "Tokenized non-sensitive payment card summary (last 4 digits and brand only) owned by a customer.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "holderName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "brand": {
          "type": "string",
          "enum": ["Troy", "Visa", "Mastercard", "Amex"]
        },
        "last4": {
          "type": "string",
          "minLength": 4,
          "maxLength": 4,
          "pattern": "^[0-9]{4}$"
        },
        "expiry": {
          "type": "string",
          "minLength": 5,
          "maxLength": 5,
          "pattern": "^(0[1-9]|1[0-2])/[0-9]{2}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "label",
        "holderName",
        "brand",
        "last4",
        "expiry",
        "createdAt",
        "updatedAt"
      ]
    },
