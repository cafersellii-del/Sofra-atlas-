        "contactEmail": {
          "type": "string",
          "minLength": 5,
          "maxLength": 120
        },
        "contactPhone": {
          "type": "string",
          "minLength": 6,
          "maxLength": 30
        },
        "streetAddress": {
          "type": "string",
          "minLength": 5,
          "maxLength": 200
        },
        "taxId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 30
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "contactEmail",
        "contactPhone",
        "streetAddress",
        "taxId",
        "updatedAt"
      ]
    },
    "PartnerDish": {
      "title": "PartnerDish",
