rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'cafersellii@gmail.com';
    }

    function isNonTurkeyRegionalAdminIdentity() {
      return isVerifiedUser()
        && request.auth.uid == 'qVBbf293ecY6F9H5Tn6aHWCUqL42'
        && request.auth.token.email == 'tayactacyvonne02@gmail.com';
    }

    function isNonTurkeyRegion(cityId) {
      return cityId is string && cityId != 'istanbul';
    }

    function isGlobalAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        (
          !('regionScope' in get(/databases/$(database)/documents/admins/$(request.auth.uid)).data) ||
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.regionScope == 'all'
        )
      );
    }

    function isNonTurkeyAdmin() {
      return isNonTurkeyRegionalAdminIdentity() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        'regionScope' in get(/databases/$(database)/documents/admins/$(request.auth.uid)).data &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.regionScope == 'non_turkey'
      );
    }

    function isAdmin() {
      return isGlobalAdmin() || isNonTurkeyAdmin();
    }

    function isAdminForRegion(cityId) {
      return isGlobalAdmin() || (isNonTurkeyAdmin() && isNonTurkeyRegion(cityId));
    }

    function isValidCityId(cityId) {
      return cityId is string
        && cityId.size() >= 2
        && cityId.size() <= 32
        && cityId.matches('^[a-z0-9\\-]+$');
    }

    function isValidCategory(cat) {
      return cat in [
        'Anadolu & Akdeniz',
        'Uzak Doğu',
        'Avrupa Klasikleri',
        'Sokak Lezzetleri',
        'Tatlı & Pastane'
      ];
    }

    function isValidRestaurant(data) {
      return data.keys().hasAll([
          'ownerId', 'name', 'cityId', 'cityName', 'district',
          'cuisineCategory', 'avgPrepMinutes', 'tagline', 'status',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'name', 'cityId', 'cityName', 'district',
          'cuisineCategory', 'avgPrepMinutes', 'tagline', 'status',
          'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && isValidId(data.ownerId)
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 80
        && isValidCityId(data.cityId)
        && data.cityName is string && data.cityName.size() >= 2 && data.cityName.size() <= 60
        && data.district is string && data.district.size() >= 2 && data.district.size() <= 60
        && isValidCategory(data.cuisineCategory)
        && data.avgPrepMinutes is string && data.avgPrepMinutes.size() >= 2 && data.avgPrepMinutes.size() <= 30
        && data.tagline is string && data.tagline.size() >= 4 && data.tagline.size() <= 200
        && data.status in ['active', 'paused']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (data.ownerId == request.auth.uid || isAdminForRegion(data.cityId));
    }

    function isValidPrivateContact(data) {
      return data.keys().hasAll([
          'ownerId', 'contactEmail', 'contactPhone', 'streetAddress', 'taxId', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'contactEmail', 'contactPhone', 'streetAddress', 'taxId', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.contactEmail is string && data.contactEmail.size() >= 5 && data.contactEmail.size() <= 120
        && data.contactPhone is string && data.contactPhone.size() >= 6 && data.contactPhone.size() <= 30
        && data.streetAddress is string && data.streetAddress.size() >= 5 && data.streetAddress.size() <= 200
        && data.taxId is string && data.taxId.size() >= 4 && data.taxId.size() <= 30
        && data.updatedAt is timestamp;
    }

    function isValidPartnerDish(data) {
      return data.keys().hasAll([
          'ownerId', 'restaurantId', 'restaurantName', 'cityId', 'cityName',
          'district', 'name', 'category', 'description', 'story', 'ingredients',
          'priceTry', 'prepMinutes', 'calories', 'isVegetarian', 'isSpicy',
          'isChefSignature', 'imagePreset', 'isPublished', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'restaurantId', 'restaurantName', 'cityId', 'cityName',
          'district', 'name', 'category', 'description', 'story', 'ingredients',
          'priceTry', 'prepMinutes', 'calories', 'isVegetarian', 'isSpicy',
          'isChefSignature', 'imagePreset', 'isPublished', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && isValidId(data.ownerId)
        && data.restaurantId is string && isValidId(data.restaurantId)
        && data.restaurantName is string && data.restaurantName.size() >= 2 && data.restaurantName.size() <= 80
        && isValidCityId(data.cityId)
        && data.cityName is string && data.cityName.size() >= 2 && data.cityName.size() <= 60
        && data.district is string && data.district.size() >= 2 && data.district.size() <= 60
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 90
        && isValidCategory(data.category)
        && data.description is string && data.description.size() >= 10 && data.description.size() <= 240
        && data.story is string && data.story.size() >= 10 && data.story.size() <= 400
        && data.ingredients is list && data.ingredients.size() >= 1 && data.ingredients.size() <= 10 && data.ingredients[0] is string
        && data.priceTry is number && data.priceTry >= 50 && data.priceTry <= 25000
        && data.prepMinutes is string && data.prepMinutes.size() >= 2 && data.prepMinutes.size() <= 30
        && data.calories is number && data.calories >= 50 && data.calories <= 5000
        && data.isVegetarian is bool
        && data.isSpicy is bool
        && data.isChefSignature is bool
        && data.imagePreset is string && data.imagePreset.size() <= 64
        && data.isPublished is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (data.ownerId == request.auth.uid || isAdminForRegion(data.cityId));
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['uid', 'email', 'note', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'note', 'regionScope', 'createdAt', 'updatedAt'])
        && data.uid is string && isValidId(data.uid)
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 120
        && data.note is string && data.note.size() >= 2 && data.note.size() <= 100
        && (!('regionScope' in data) || data.regionScope in ['all', 'non_turkey'])
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCustomerOrder(data) {
      return data.keys().hasAll([
          'ownerId', 'orderNumber', 'cityId', 'cityName', 'neighborhood',
          'address', 'customerName', 'customerPhone', 'restaurantName',
          'paymentMethod', 'paymentStatus', 'gatewayLabel', 'transactionId',
          'authCode', 'cardBrand', 'cardLast4', 'refundId',
          'deliveryPreferences', 'itemsSummary', 'subtotalTry', 'discountTry',
          'deliveryFeeTry', 'totalTry', 'status', 'estimatedArrival',
          'courierName', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'orderNumber', 'cityId', 'cityName', 'neighborhood',
          'address', 'customerName', 'customerPhone', 'restaurantName',
          'paymentMethod', 'paymentStatus', 'gatewayLabel', 'transactionId',
          'authCode', 'cardBrand', 'cardLast4', 'refundId',
          'deliveryPreferences', 'itemsSummary', 'subtotalTry', 'discountTry',
          'deliveryFeeTry', 'serviceFeeTry', 'commissionRatePct',
          'commissionTry', 'restaurantNetTry', 'totalTry', 'status',
          'estimatedArrival', 'courierName', 'courierId', 'courierStatus',
          'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && isValidId(data.ownerId)
        && data.orderNumber is string && data.orderNumber.size() >= 4 && data.orderNumber.size() <= 32
        && isValidCityId(data.cityId)
        && data.cityName is string && data.cityName.size() >= 2 && data.cityName.size() <= 60
        && data.neighborhood is string && data.neighborhood.size() >= 2 && data.neighborhood.size() <= 60
        && data.address is string && data.address.size() >= 5 && data.address.size() <= 200
        && data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 80
        && data.customerPhone is string && data.customerPhone.size() >= 6 && data.customerPhone.size() <= 30
        && data.restaurantName is string && data.restaurantName.size() >= 2 && data.restaurantName.size() <= 80
        && data.paymentMethod in ['card', 'digital_wallet', 'cash_on_delivery']
        && data.paymentStatus in ['paid', 'pending_cod', 'refunded']
        && data.gatewayLabel is string && data.gatewayLabel.size() <= 60
        && data.transactionId is string && data.transactionId.size() <= 64
        && data.authCode is string && data.authCode.size() <= 24
        && data.cardBrand is string && data.cardBrand.size() <= 24
        && data.cardLast4 is string && data.cardLast4.size() <= 4
        && data.refundId is string && data.refundId.size() <= 64
        && data.deliveryPreferences is list
        && data.deliveryPreferences.size() <= 4
        && data.deliveryPreferences.hasOnly(['Temassız teslimat', 'Zili çalmayın'])
        && data.itemsSummary is list
        && data.itemsSummary.size() >= 1 && data.itemsSummary.size() <= 25
        && data.itemsSummary[0] is string
        && data.subtotalTry is number && data.subtotalTry >= 0 && data.subtotalTry <= 500000
        && data.discountTry is number && data.discountTry >= 0 && data.discountTry <= 500000
        && data.deliveryFeeTry is number && data.deliveryFeeTry >= 0 && data.deliveryFeeTry <= 10000
        && (!('serviceFeeTry' in data) || (data.serviceFeeTry is number && data.serviceFeeTry >= 0 && data.serviceFeeTry <= 10000))
        && (!('commissionRatePct' in data) || (data.commissionRatePct is number && data.commissionRatePct >= 0 && data.commissionRatePct <= 100))
        && (!('commissionTry' in data) || (data.commissionTry is number && data.commissionTry >= 0 && data.commissionTry <= 500000))
        && (!('restaurantNetTry' in data) || (data.restaurantNetTry is number && data.restaurantNetTry >= 0 && data.restaurantNetTry <= 500000))
        && data.totalTry is number && data.totalTry >= 1 && data.totalTry <= 500000
        && data.status in ['received', 'preparing', 'on_the_way', 'delivered']
        && data.estimatedArrival is string && data.estimatedArrival.size() >= 2 && data.estimatedArrival.size() <= 40
        && data.courierName is string && data.courierName.size() >= 2 && data.courierName.size() <= 60
        && (!('courierId' in data) || (data.courierId is string && data.courierId.size() <= 128 && (data.courierId == '' || isValidId(data.courierId))))
        && (!('courierStatus' in data) || data.courierStatus in ['waiting_courier', 'accepted', 'picked_up', 'delivered'])
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (
          data.ownerId == request.auth.uid ||
          isAdminForRegion(data.cityId)
        );
    }

    function isValidSavedCard(data) {
      return data.keys().hasAll([
          'ownerId', 'label', 'holderName', 'brand', 'last4', 'expiry',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'label', 'holderName', 'brand', 'last4', 'expiry',
          'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.label is string && data.label.size() >= 2 && data.label.size() <= 40
        && data.holderName is string && data.holderName.size() >= 2 && data.holderName.size() <= 80
        && data.brand in ['Troy', 'Visa', 'Mastercard', 'Amex']
        && data.last4 is string && data.last4.size() == 4 && data.last4.matches('^[0-9]{4}$')
        && data.expiry is string && data.expiry.size() == 5 && data.expiry.matches('^(0[1-9]|1[0-2])/[0-9]{2}$')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMemberProfile(data) {
      return data.keys().hasAll([
          'ownerId', 'displayName', 'email', 'phone', 'defaultCityId',
          'defaultProvince', 'defaultDistrict', 'defaultAddress',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'displayName', 'email', 'phone', 'defaultCityId',
          'defaultProvince', 'defaultDistrict', 'defaultAddress',
          'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 80
        && data.email is string && data.email.size() <= 120
        && data.phone is string && data.phone.size() <= 30
        && isValidCityId(data.defaultCityId)
        && data.defaultProvince is string && data.defaultProvince.size() >= 2 && data.defaultProvince.size() <= 60
        && data.defaultDistrict is string && data.defaultDistrict.size() >= 2 && data.defaultDistrict.size() <= 60
        && data.defaultAddress is string && data.defaultAddress.size() <= 200
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCourierProfile(data) {
      return data.keys().hasAll([
          'ownerId', 'fullName', 'cityId', 'cityName', 'district',
          'vehicleType', 'plateOrBagCode', 'availability', 'completedDeliveries',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'fullName', 'cityId', 'cityName', 'district',
          'vehicleType', 'plateOrBagCode', 'availability', 'completedDeliveries',
          'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && isValidId(data.ownerId)
        && (data.ownerId == request.auth.uid || isGlobalAdmin())
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 80
        && isValidCityId(data.cityId)
        && data.cityName is string && data.cityName.size() >= 2 && data.cityName.size() <= 60
        && data.district is string && data.district.size() >= 2 && data.district.size() <= 60
        && data.vehicleType in ['motorcycle', 'bicycle', 'ebike', 'car']
        && data.plateOrBagCode is string && data.plateOrBagCode.size() >= 2 && data.plateOrBagCode.size() <= 30
        && data.availability in ['online', 'busy', 'offline']
        && data.completedDeliveries is number && data.completedDeliveries >= 0 && data.completedDeliveries <= 100000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCourierPrivateContact(data) {
      return data.keys().hasAll([
          'ownerId', 'contactEmail', 'contactPhone', 'licenseOrTaxId', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'contactEmail', 'contactPhone', 'licenseOrTaxId', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == request.auth.uid && isValidId(data.ownerId)
        && data.contactEmail is string && data.contactEmail.size() >= 5 && data.contactEmail.size() <= 120
        && data.contactPhone is string && data.contactPhone.size() >= 6 && data.contactPhone.size() <= 30
        && data.licenseOrTaxId is string && data.licenseOrTaxId.size() >= 4 && data.licenseOrTaxId.size() <= 30
        && data.updatedAt is timestamp;
    }

    function isValidDispatchJob(data) {
      return data.keys().hasAll([
          'orderId', 'orderNumber', 'ownerId', 'cityId', 'cityName',
          'neighborhood', 'restaurantName', 'itemsCount', 'totalTry',
          'courierEarningsTry', 'estimatedArrival', 'paymentMethod',
          'deliveryPreferences', 'courierId', 'courierName', 'status',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'orderId', 'orderNumber', 'ownerId', 'cityId', 'cityName',
          'neighborhood', 'restaurantName', 'itemsCount', 'totalTry',
          'courierEarningsTry', 'estimatedArrival', 'paymentMethod',
          'deliveryPreferences', 'courierId', 'courierName', 'status',
          'createdAt', 'updatedAt'
        ])
        && data.orderId is string && isValidId(data.orderId)
        && data.orderNumber is string && data.orderNumber.size() >= 4 && data.orderNumber.size() <= 32
        && data.ownerId is string && isValidId(data.ownerId)
        && isValidCityId(data.cityId)
        && data.cityName is string && data.cityName.size() >= 2 && data.cityName.size() <= 60
        && data.neighborhood is string && data.neighborhood.size() >= 2 && data.neighborhood.size() <= 60
        && data.restaurantName is string && data.restaurantName.size() >= 2 && data.restaurantName.size() <= 80
        && data.itemsCount is number && data.itemsCount >= 1 && data.itemsCount <= 100
        && data.totalTry is number && data.totalTry >= 1 && data.totalTry <= 500000
        && data.courierEarningsTry is number && data.courierEarningsTry >= 0 && data.courierEarningsTry <= 50000
        && data.estimatedArrival is string && data.estimatedArrival.size() >= 2 && data.estimatedArrival.size() <= 40
        && data.paymentMethod in ['card', 'digital_wallet', 'cash_on_delivery']
        && data.deliveryPreferences is list
        && data.deliveryPreferences.size() <= 4
        && data.deliveryPreferences.hasOnly(['Temassız teslimat', 'Zili çalmayın'])
        && data.courierId is string && data.courierId.size() <= 128 && (data.courierId == '' || isValidId(data.courierId))
        && data.courierName is string && data.courierName.size() <= 60
        && data.status in ['open', 'accepted', 'picked_up', 'delivered']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCommissionConfig(data) {
      return data.keys().hasAll([
          'commissionMode', 'restaurantCommissionPct', 'fixedCommissionTry',
          'customerServiceFeeTry', 'courierSharePct', 'courierMinFeeTry',
          'minCommissionTry', 'updatedByEmail', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'commissionMode', 'restaurantCommissionPct', 'fixedCommissionTry',
          'customerServiceFeeTry', 'courierSharePct', 'courierMinFeeTry',
          'minCommissionTry', 'updatedByEmail', 'updatedAt'
        ])
        && data.commissionMode in ['percentage', 'fixed', 'hybrid']
        && data.restaurantCommissionPct is number && data.restaurantCommissionPct >= 0 && data.restaurantCommissionPct <= 50
        && data.fixedCommissionTry is number && data.fixedCommissionTry >= 0 && data.fixedCommissionTry <= 5000
        && data.customerServiceFeeTry is number && data.customerServiceFeeTry >= 0 && data.customerServiceFeeTry <= 1000
        && data.courierSharePct is number && data.courierSharePct >= 0 && data.courierSharePct <= 50
        && data.courierMinFeeTry is number && data.courierMinFeeTry >= 0 && data.courierMinFeeTry <= 1000
        && data.minCommissionTry is number && data.minCommissionTry >= 0 && data.minCommissionTry <= 5000
        && data.updatedByEmail is string && data.updatedByEmail.size() >= 5 && data.updatedByEmail.size() <= 120
        && data.updatedAt is timestamp;
    }

    function isValidRestaurantCommissionOverride(data) {
      return data.keys().hasAll([
          'restaurantName', 'commissionMode', 'restaurantCommissionPct',
          'fixedCommissionTry', 'note', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'restaurantName', 'cityId', 'commissionMode', 'restaurantCommissionPct',
          'fixedCommissionTry', 'note', 'updatedAt'
        ])
        && data.restaurantName is string && data.restaurantName.size() >= 2 && data.restaurantName.size() <= 80
        && (!('cityId' in data) || isValidCityId(data.cityId))
        && data.commissionMode in ['percentage', 'fixed', 'hybrid']
        && data.restaurantCommissionPct is number && data.restaurantCommissionPct >= 0 && data.restaurantCommissionPct <= 50
        && data.fixedCommissionTry is number && data.fixedCommissionTry >= 0 && data.fixedCommissionTry <= 5000
        && data.note is string && data.note.size() <= 160
        && data.updatedAt is timestamp;
    }

    match /admins/{adminId} {
      allow get: if isVerifiedUser() && isValidId(adminId) && (
        adminId == request.auth.uid ||
        isGlobalAdmin() ||
        (
          isNonTurkeyAdmin() &&
          resource != null &&
          'regionScope' in existing() &&
          existing().regionScope == 'non_turkey'
        )
      );
      allow list: if isBootstrappedAdmin() || (
        isVerifiedUser() && resource.data.uid == request.auth.uid
      ) || (
        isNonTurkeyRegionalAdminIdentity() &&
        'regionScope' in resource.data &&
        resource.data.regionScope == 'non_turkey'
      );
      allow create: if isVerifiedUser()
        && isValidId(adminId)
        && isValidAdminUser(incoming())
        && incoming().uid == adminId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isGlobalAdmin() ||
          (
            isNonTurkeyAdmin() &&
            'regionScope' in incoming() &&
            incoming().regionScope == 'non_turkey'
          )
        );
      allow update: if isVerifiedUser()
        && isValidId(adminId)
        && isValidAdminUser(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            isGlobalAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['email', 'note', 'regionScope', 'updatedAt'])
          ) ||
          (
            isNonTurkeyAdmin() &&
            adminId != 'qVBbf293ecY6F9H5Tn6aHWCUqL42' &&
            'regionScope' in existing() &&
            existing().regionScope == 'non_turkey' &&
            'regionScope' in incoming() &&
            incoming().regionScope == 'non_turkey' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['email', 'note', 'updatedAt'])
          )
        );
      allow delete: if isVerifiedUser()
        && isValidId(adminId)
        && resource != null
        && (
          isGlobalAdmin() ||
          (
            isNonTurkeyAdmin() &&
            adminId != request.auth.uid &&
            adminId != 'qVBbf293ecY6F9H5Tn6aHWCUqL42' &&
            'regionScope' in existing() &&
            existing().regionScope == 'non_turkey'
          )
        );
    }

    match /restaurants/{restaurantId} {
      allow get: if isValidId(restaurantId) && (
        (isSignedIn() && restaurantId == request.auth.uid && resource == null) ||
        (resource != null && existing().status == 'active') ||
        (isSignedIn() && resource != null && existing().ownerId == request.auth.uid) ||
        (resource != null && isAdminForRegion(existing().cityId))
      );
      allow list: if resource.data.status == 'active' ||
        (isSignedIn() && resource.data.ownerId == request.auth.uid) ||
        isBootstrappedAdmin() ||
        (isNonTurkeyRegionalAdminIdentity() && isNonTurkeyRegion(resource.data.cityId));

      allow create: if isVerifiedUser()
        && isValidId(restaurantId)
        && isValidRestaurant(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          restaurantId == request.auth.uid ||
          isAdminForRegion(incoming().cityId)
        );

      allow update: if isVerifiedUser()
        && isValidId(restaurantId)
        && isValidRestaurant(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            isAdminForRegion(existing().cityId) &&
            isAdminForRegion(incoming().cityId) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'cityId', 'cityName', 'district', 'cuisineCategory',
              'avgPrepMinutes', 'tagline', 'status', 'updatedAt'
            ])
          ) ||
          (
            restaurantId == request.auth.uid &&
            existing().ownerId == request.auth.uid &&
            (
              incoming().diff(existing()).affectedKeys().hasOnly([
                'name', 'cityId', 'cityName', 'district', 'cuisineCategory',
                'avgPrepMinutes', 'tagline', 'updatedAt'
              ]) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
            )
          )
        );

      allow delete: if isVerifiedUser()
        && isValidId(restaurantId)
        && resource != null
        && isAdminForRegion(existing().cityId);

      match /private/{docId} {
        allow get: if isVerifiedUser()
          && isValidId(restaurantId)
          && isValidId(docId)
          && docId == 'contact'
          && (
            (request.auth.uid == restaurantId && (resource == null || existing().ownerId == request.auth.uid)) ||
            (
              exists(/databases/$(database)/documents/restaurants/$(restaurantId)) &&
              isAdminForRegion(get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.cityId)
            )
          );
        allow list: if false;

        allow create: if isVerifiedUser()
          && isValidId(restaurantId)
          && isValidId(docId)
          && docId == 'contact'
          && request.auth.uid == restaurantId
          && existsAfter(/databases/$(database)/documents/restaurants/$(restaurantId))
          && isValidPrivateContact(incoming())
          && incoming().updatedAt == request.time;

        allow update: if isVerifiedUser()
          && isValidId(restaurantId)
          && isValidId(docId)
          && docId == 'contact'
          && request.auth.uid == restaurantId
          && existing().ownerId == request.auth.uid
          && isValidPrivateContact(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'contactEmail', 'contactPhone', 'streetAddress', 'taxId', 'updatedAt'
          ]);

        allow delete: if isValidId(restaurantId) && isValidId(docId) && (
          (!exists(/databases/$(database)/documents/restaurants/$(restaurantId)) && isGlobalAdmin()) ||
          (
            exists(/databases/$(database)/documents/restaurants/$(restaurantId)) &&
            isAdminForRegion(get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.cityId)
          )
        );
      }
    }

    match /dishes/{dishId} {
      allow get: if isValidId(dishId) && resource != null && (
        existing().isPublished == true ||
        (isSignedIn() && existing().ownerId == request.auth.uid) ||
        isAdminForRegion(existing().cityId)
      );
      allow list: if resource.data.isPublished == true ||
        (isSignedIn() && resource.data.ownerId == request.auth.uid) ||
        isBootstrappedAdmin() ||
        (isNonTurkeyRegionalAdminIdentity() && isNonTurkeyRegion(resource.data.cityId));

      allow create: if isVerifiedUser()
        && isValidId(dishId)
        && isValidPartnerDish(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/restaurants/$(incoming().restaurantId))
        && (
          (
            incoming().restaurantId == request.auth.uid &&
            incoming().ownerId == request.auth.uid &&
            get(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)).data.ownerId == request.auth.uid
          ) || (
            isAdminForRegion(incoming().cityId) &&
            isAdminForRegion(get(/databases/$(database)/documents/restaurants/$(incoming().restaurantId)).data.cityId)
          )
        );

      allow update: if isVerifiedUser()
        && isValidId(dishId)
        && isValidPartnerDish(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().restaurantId == existing().restaurantId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            isAdminForRegion(existing().cityId) &&
            isAdminForRegion(incoming().cityId) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'isPublished', 'name', 'category', 'description', 'story',
              'ingredients', 'priceTry', 'prepMinutes', 'calories',
              'isVegetarian', 'isSpicy', 'isChefSignature', 'imagePreset',
              'cityId', 'cityName', 'district', 'restaurantName', 'updatedAt'
            ])
          ) ||
          (
            existing().ownerId == request.auth.uid &&
            (
              incoming().diff(existing()).affectedKeys().hasOnly(['isPublished', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly([
                'name', 'category', 'description', 'story', 'ingredients',
                'priceTry', 'prepMinutes', 'calories', 'isVegetarian',
                'isSpicy', 'isChefSignature', 'imagePreset', 'updatedAt'
              ])
            )
          )
        );

      allow delete: if isVerifiedUser()
        && isValidId(dishId)
        && resource != null
        && (existing().ownerId == request.auth.uid || isAdminForRegion(existing().cityId));
    }

    match /orders/{orderId} {
      allow get: if isVerifiedUser() && isValidId(orderId) && resource != null && (
        existing().ownerId == request.auth.uid ||
        isAdminForRegion(existing().cityId)
      );
      allow list: if isVerifiedUser() && (
        resource.data.ownerId == request.auth.uid ||
        isBootstrappedAdmin() ||
        (isNonTurkeyRegionalAdminIdentity() && isNonTurkeyRegion(resource.data.cityId))
      );

      allow create: if isVerifiedUser()
        && isValidId(orderId)
        && isValidCustomerOrder(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().status == 'received'
        && incoming().refundId == ''
        && (!('courierId' in incoming()) || incoming().courierId == '')
        && (!('courierStatus' in incoming()) || incoming().courierStatus in ['accepted', 'waiting_courier'])
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(orderId)
        && isValidCustomerOrder(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().orderNumber == existing().orderNumber
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            isAdminForRegion(existing().cityId) &&
            isAdminForRegion(incoming().cityId) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'paymentStatus', 'refundId', 'courierId',
              'courierName', 'courierStatus', 'updatedAt'
            ])
          ) ||
          (
            existing().ownerId == request.auth.uid &&
            existing().status != 'delivered' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );

      allow delete: if isVerifiedUser()
        && isValidId(orderId)
        && resource != null
        && isAdminForRegion(existing().cityId);
    }

    // Platform courier onboarding is disabled; deliveries are handled by restaurant couriers
    match /couriers/{courierId} {
      allow get: if isVerifiedUser() && isValidId(courierId) && isGlobalAdmin();
      allow list: if isBootstrappedAdmin();
      allow create, update: if false;
      allow delete: if isGlobalAdmin() && isValidId(courierId);

      match /private/{docId} {
        allow get: if isVerifiedUser() && isValidId(courierId) && isValidId(docId) && docId == 'contact' && isGlobalAdmin();
        allow list, create, update: if false;
        allow delete: if isGlobalAdmin() && isValidId(courierId) && isValidId(docId);
      }
    }

    // Platform courier dispatch queue is disabled; restaurants fulfill with their own couriers
    match /dispatchJobs/{jobId} {
      allow get: if isVerifiedUser() && isValidId(jobId) && isGlobalAdmin();
      allow list: if isBootstrappedAdmin();
      allow create, update: if false;
      allow delete: if isGlobalAdmin() && isValidId(jobId);
    }

    match /users/{userId} {
      allow get: if isVerifiedUser()
        && isValidId(userId)
        && (
          (request.auth.uid == userId && (resource == null || existing().ownerId == request.auth.uid)) ||
          (resource != null && isAdminForRegion(existing().defaultCityId))
        );
      allow list: if isBootstrappedAdmin() || (
        isVerifiedUser() && resource.data.ownerId == request.auth.uid
      ) || (
        isNonTurkeyRegionalAdminIdentity() && isNonTurkeyRegion(resource.data.defaultCityId)
      );

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidMemberProfile(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && existing().ownerId == request.auth.uid
        && isValidMemberProfile(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'email', 'phone', 'defaultCityId', 'defaultProvince',
          'defaultDistrict', 'defaultAddress', 'updatedAt'
        ]);

      allow delete: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && existing().ownerId == request.auth.uid;
    }

    match /users/{userId}/savedCards/{cardId} {
      allow get: if isVerifiedUser()
        && isValidId(userId)
        && isValidId(cardId)
        && request.auth.uid == userId
        && (resource == null || existing().ownerId == request.auth.uid);
      allow list: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && resource.data.ownerId == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isValidId(cardId)
        && request.auth.uid == userId
        && isValidSavedCard(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidId(cardId)
        && request.auth.uid == userId
        && existing().ownerId == request.auth.uid
        && isValidSavedCard(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['label', 'updatedAt']);

      allow delete: if isVerifiedUser()
        && isValidId(userId)
        && isValidId(cardId)
        && request.auth.uid == userId
        && existing().ownerId == request.auth.uid;
    }

    // Platform-wide and non-Turkey regional commission settings
    match /platformSettings/{settingId} {
      allow get: if isValidId(settingId) && settingId in ['commission', 'commission_non_turkey'];
      allow list: if false;

      allow create: if isVerifiedUser()
        && isValidId(settingId)
        && settingId in ['commission', 'commission_non_turkey']
        && isValidCommissionConfig(incoming())
        && incoming().updatedByEmail == request.auth.token.email
        && incoming().updatedAt == request.time
        && (
          settingId == 'commission'
            ? isGlobalAdmin()
            : isAdmin()
        );

      allow update: if isVerifiedUser()
        && isValidId(settingId)
        && settingId in ['commission', 'commission_non_turkey']
        && isValidCommissionConfig(incoming())
        && incoming().updatedByEmail == request.auth.token.email
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'commissionMode', 'restaurantCommissionPct', 'fixedCommissionTry',
          'customerServiceFeeTry', 'courierSharePct', 'courierMinFeeTry',
          'minCommissionTry', 'updatedByEmail', 'updatedAt'
        ])
        && (
          settingId == 'commission'
            ? isGlobalAdmin()
            : isAdmin()
        );

      allow delete: if false;
    }

    // Per-restaurant custom commission rate overrides managed by admins
    match /restaurantCommissions/{restaurantId} {
      allow get: if isValidId(restaurantId);
      allow list: if isBootstrappedAdmin() || (
        isNonTurkeyRegionalAdminIdentity() &&
        'cityId' in resource.data &&
        isNonTurkeyRegion(resource.data.cityId)
      );

      allow create: if isVerifiedUser()
        && isValidId(restaurantId)
        && isValidRestaurantCommissionOverride(incoming())
        && incoming().updatedAt == request.time
        && (
          isGlobalAdmin() ||
          (
            isNonTurkeyAdmin() &&
            'cityId' in incoming() &&
            isNonTurkeyRegion(incoming().cityId)
          )
        );

      allow update: if isVerifiedUser()
        && isValidId(restaurantId)
        && isValidRestaurantCommissionOverride(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'restaurantName', 'cityId', 'commissionMode', 'restaurantCommissionPct',
          'fixedCommissionTry', 'note', 'updatedAt'
        ])
        && (
          isGlobalAdmin() ||
          (
            isNonTurkeyAdmin() &&
            'cityId' in existing() &&
            isNonTurkeyRegion(existing().cityId) &&
            'cityId' in incoming() &&
            isNonTurkeyRegion(incoming().cityId)
          )
        );

      allow delete: if isVerifiedUser()
        && isValidId(restaurantId)
        && resource != null
        && (
          isGlobalAdmin() ||
          (
            isNonTurkeyAdmin() &&
            'cityId' in existing() &&
            isNonTurkeyRegion(existing().cityId)
          )
        );
    }

    // Boot-time connectivity check document (read-only ping)
    match /test/{docId} {
      allow get: if docId == 'connection';
      allow list, write: if false;
    }
  }
}
